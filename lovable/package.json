{
  "name": "self-hosted-lovable",
  "version": "1.0.0",
  "description": "Self-hosted Lovable - AI-powered app builder that runs on your server",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:pocketbase\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:pocketbase": "./scripts/start-pocketbase.sh",
    "build": "cd frontend && npm run build",
    "preview": "cd frontend && npm run preview",
    "setup": "./scripts/setup.sh"
  },
  "keywords": ["lovable", "ai", "code-generation", "sveltekit", "pocketbase"],
  "license": "MIT"
}
